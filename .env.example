# Copy to .env.local and fill in real values. .env* is gitignored.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Unipile (LinkedIn automation) ─────────────────────────────────────────────
UNIPILE_API_KEY=
# Host:port of your Unipile DSN, e.g. api13.unipile.com:14349
UNIPILE_DSN=
UNIPILE_ACCOUNT_ID=

# ── Apify (profile scraping) ──────────────────────────────────────────────────
APIFY_API_TOKEN=

# ── OpenAI (message personalization) ──────────────────────────────────────────
OPENAI_API_KEY=
# Free-text description of what you're pitching, injected into the AI
# copywriter's system prompt. Without it the model is told not to invent any
# product claims. Example:
#   OUTREACH_PRODUCT_CONTEXT="Acme Analytics — usage-based BI for product teams.
#   Cuts reporting time by 60%. Integrates with Snowflake, BigQuery, Postgres."
OUTREACH_PRODUCT_CONTEXT=

# ── Branding ──────────────────────────────────────────────────────────────────
# All optional — sensible generic defaults ship in src/constants/branding.ts.
# Must be NEXT_PUBLIC_* so the sidebar/login client components can read them.
NEXT_PUBLIC_APP_NAME=LinkedIn Outreach Engine
NEXT_PUBLIC_APP_SHORT_NAME=Outreach Engine
# Where the "Contact support" link on error states points
NEXT_PUBLIC_SUPPORT_URL=
# Meeting-booking link used by the inbox "Book Meeting" quick reply. Leave empty
# to keep that button disabled rather than inserting a dead link.
NEXT_PUBLIC_BOOKING_URL=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret echoed by Unipile in the Unipile-Auth webhook header
WEBHOOK_SECRET=
# Bearer token guarding /api/cron/run-sequences — the only thing that drives the
# sequence executor (see the schedule in vercel.json). REQUIRED: the route
# returns 500 and runs nothing while this is unset, so a deploy without it looks
# healthy but never sends. Vercel Cron sends this header automatically once the
# variable is set on the project.
CRON_SECRET=

# ── n8n (workflow automation control plane) ───────────────────────────────────
# Base URL of the n8n instance (no trailing slash)
N8N_BASE_URL=https://n8n.srv1183265.hstgr.cloud
# n8n public API key — create at n8n → Settings → API. Sent as X-N8N-API-KEY.
# NOTE: this is NOT the MCP JWT in .mcp.json; that only works for the MCP endpoint.
N8N_API_KEY=
# Shared secret the n8n HTTP Request nodes echo in the `x-n8n-auth` header when
# POSTing events to /api/webhooks/n8n
N8N_WEBHOOK_SECRET=
# Which engine owns outreach execution: "n8n" (recommended) disables the
# dashboard's local sequence executor + Unipile webhook so the two engines can't
# double-send. Set to "dashboard" to keep the local executor authoritative.
AUTOMATION_ENGINE=n8n
# Supabase user id that n8n-synced leads (which have no session) are attached to.
# Single-operator system. If unset, the ingest webhook falls back to the oldest
# row in `settings` (there is no `profiles` table — see leadSync.resolveOwnerUserId).
DASHBOARD_OWNER_USER_ID=

# ── Logging ───────────────────────────────────────────────────────────────────
# One of: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
